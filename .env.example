# ════════════════════════════════════════════════════════════════
# SoftSentry — Environment Variables (Example)
# Copy to `.env` then fill in real values for development.
# Production: ใช้ secrets manager (Vault/SOPS) — อย่าเก็บ .env ใน prod
# ════════════════════════════════════════════════════════════════

# ─── Backend ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://softsentry:dev_password@postgres:5432/softsentry
REDIS_URL=redis://:dev_password@redis:6379/0

# Generate: openssl rand -hex 32
JWT_SECRET=change_me_run_openssl_rand_hex_32
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Optional extra pepper appended to bcrypt input. Blank ok in dev.
BCRYPT_PEPPER=

# Generate: openssl rand -hex 32
LICENSE_KEY_ENCRYPTION_KEY=change_me_run_openssl_rand_hex_32

DASHBOARD_URL=http://localhost:3000
LOG_LEVEL=INFO
ENV=development                  # development | staging | production
ENABLE_DOCS=true                 # exposes /docs (Swagger UI)

# Initial admin (used once by seed script)
INITIAL_ADMIN_EMAIL=admin@local
INITIAL_ADMIN_PASSWORD=ChangeMe!2026

# NVD / OSV (Phase 3)
NVD_API_KEY=
OSV_API_BASE=https://api.osv.dev/v1

# Agent auto-update (Phase 2): directory holding agent binaries + manifest.json.
# Empty disables the auto-update distribution endpoints.
AGENT_BINARY_DIR=

# ─── Dashboard ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=th

# ─── Postgres ───────────────────────────────────────────────────
POSTGRES_USER=softsentry
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=softsentry

# ─── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=dev_password

# ─── Grafana ────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=dev_password
