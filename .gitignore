# ── Secrets / env ──────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Server-only config (เครื่องนี้ใช้ local; ของ server แยก ไม่ขึ้น repo) ──
.env.server
docker-compose.forserver.yml

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.tox/

# ── Node / Next.js ─────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
.pnpm-store/

# ── Go ─────────────────────────────────────────────────────────
agent/bin/
agent/dist/
*.exe
*.test
*.prof
vendor/

# Built agent binaries are committed so they reach the server (the
# agent-binaries dir is bind-mounted into the backend container). Negate the
# *.exe rule above for this dir only — everywhere else *.exe stays ignored.
!backend/agent-binaries/*.exe

# ── Docker ─────────────────────────────────────────────────────
*.log

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo

# ── Project local ──────────────────────────────────────────────
# anchor ด้วย / นำหน้า: ignore เฉพาะโฟลเดอร์ output ที่ repo root
# (ไม่งั้นจะไปกิน source เช่น dashboard/components/reports/, backend/app/reports/)
/reports/
/backups/
/data/
infra/nginx/certs/*
!infra/nginx/certs/.gitkeep
agent/.softsentry/

# ── Test artifacts ─────────────────────────────────────────────
test-results/
playwright-report/
coverage/

# ── Docs (ไม่ commit เข้า repo — เก็บ local เท่านั้น) ──────────
docs/
