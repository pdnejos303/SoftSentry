# ── Secrets / env ──────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Server-only config (เครื่องนี้ใช้ local; ของ server แยก ไม่ขึ้น repo) ──
.env.server
docker-compose.forserver.yml

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.tox/

# ── Node / Next.js ─────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
.pnpm-store/

# ── Go ─────────────────────────────────────────────────────────
agent/bin/
agent/dist/
*.exe
*.test
*.prof
vendor/
# stray compiled agent binaries (no .exe extension → ไม่โดน *.exe ด้านบนจับ)
/agent/softsentry-agent
/agent/softsentry-agent-*

# generated Windows resource object (manifest .syso) — สร้างตอน build จาก
# cmd/softsentry-agent/app.manifest ผ่าน rsrc; ไม่ commit (regenerate ได้เสมอ)
*.syso

# Agent binaries ถูก build ตอน `docker compose build` โดย stage `agent-builder`
# แล้ว publish ลง named volume `agent_binaries` — ไม่ commit เข้า git อีกต่อไป
# (local non-docker dev ยัง drop build ไว้ที่นี่ได้ผ่าน agent/build.ps1)
/backend/agent-binaries/

# ── Docker ─────────────────────────────────────────────────────
*.log

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo

# ── Project local ──────────────────────────────────────────────
# anchor ด้วย / นำหน้า: ignore เฉพาะโฟลเดอร์ output ที่ repo root
# (ไม่งั้นจะไปกิน source เช่น dashboard/components/reports/, backend/app/reports/)
/reports/
/backups/
/data/
infra/nginx/certs/*
!infra/nginx/certs/.gitkeep
agent/.softsentry/

# ── Test artifacts ─────────────────────────────────────────────
test-results/
playwright-report/
coverage/

# ── Docs (ไม่ commit เข้า repo — เก็บ local เท่านั้น) ──────────
docs/
